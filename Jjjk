local Scripts = {
    [6765805766] = {
        Name = "Block Spin",
        Load = function()
            -- 🛡️ เพิ่มการหน่วงเวลาแบบสุ่ม — ตรวจจับยากขึ้น
            task.wait(math.random(600, 1800) / 1000)
            
            -- 🔄 มีลิงก์สำรอง ถ้าลิงก์หลักไม่ทำงาน
            local urls = {
                "https://api.jnkie.com/api/v1/luascripts/public/397b62fded2dc221325ed31cc6906a35baab4cda5b17d57b9dc8fd22f5026a40/download",
                -- เพิ่มลิงก์สำรองตรงนี้ถ้าต้องการ
            }
            
            local function tryLoad()
                for _, url in ipairs(urls) do
                    local success, result = pcall(function()
                        return game:HttpGet(url)
                    end)
                    if success and result then
                        loadstring(result)()
                        return true
                    end
                end
                return false
            end
            
            local loaded = tryLoad()
            if not loaded then
                warn("[!] Failed to load script")
            end
        end
    },
}

local godzila = Scripts[game.GameId]
if not godzila then
    -- ✅ แก้: ไม่เตะออกทันที แจ้งเตือนอย่างเดียว ป้องกันโดนแบน
    warn("Game not supported")
    return
end

print("Loaded for " .. godzila.Name)
pcall(function()
    godzila.Load()
end)
