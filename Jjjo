-- 🔄 MAIN LOOP
-- ==============================================
RunService.RenderStepped:Connect(function()
    if State.AutoLockNearest then
        State.Nearest = GetNearestPlayer()
    end

    if State.Camlock_Enabled and State.HoldingAim and State.Target then
        local LockPos = GetLockPos(State.Target)
        if LockPos then
            local Smooth = State.AntiBan_Enabled and CONFIG.AntiBanSmooth or 1
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, LockPos), 1/Smooth)
        end
    end

    UpdateESP()
    UpdateMagnet()
end)

