local function UpdateMagnet()
    if not State.Magnet_Enabled or not Root then return end

    -- ปรับชื่อของตามเกมนั้น ๆ ของคุณ
    local Items = Workspace:GetDescendants()
    for _, Item in ipairs(Items) do
        -- เช็คว่าเป็นของที่สามารถดูดได้
        if Item:IsA("BasePart") and (Item.Name == "Coin" or Item.Name == "Gem" or Item.Name == "Drop" or Item.Name == "Item") then
            local Dist = (Root.Position - Item.Position).Magnitude
            if Dist < CONFIG.Magnet_Range then
                -- ดูดเข้าหาตัว
                local Direction = (Root.Position + Vector3.new(0, CONFIG.Magnet_HeightOffset, 0) - Item.Position).Unit
                Item.Velocity = Item.Velocity:Lerp(Direction * CONFIG.Magnet_Speed, 0.15)
            end
        end
    end
end

