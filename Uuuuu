        StatusDot.BackgroundColor3 = Color3.fromRGB(120, 120, 120) -- เทา = ปิด
        StatusText.Text = "🔴 กดปุ่ม 1v1 เพื่อเปิด"
        StatusText.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    end
end

