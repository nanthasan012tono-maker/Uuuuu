-- ==============================================
-- ⌨️ กด E ค้างเพื่อล็อคเป้าหมาย
-- ==============================================
UIS.InputBegan:Connect(function(Input, GP)
    if GP then return end
    if Input.KeyCode == CONFIG.LockKey and State.SystemActive then
        State.Holding = true
    end
end)

UIS.InputEnded:Connect(function(Input, GP)
    if GP then return end
    if Input.KeyCode == CONFIG.LockKey then
        State.Holding = false
        State.Target = nil
    end
end)

-- ==============================================
-- 🎯 หาเป้าหมาย — คนใกล้สุดใน FOV
-- ==============================================
local function GetBestTarget()
    if not Root or not State.SystemActive then return nil end
    local Best, BestScore = nil, math.huge

    for _, Plr in ipairs(Players:GetPlayers()) do
        if Plr == LocalPlayer then continue end
        if not Plr.Character then continue end
        local PHead = Plr.Character:FindFirstChild("Head")
        local PRoot = Plr.Character:FindFirstChild("HumanoidRootPart")
        if not PHead or not PRoot then continue end

        -- ระยะ
        local Dist = (Root.Position - PRoot.Position).Magnitude
        if Dist > CONFIG.MaxDistance then continue end

        -- มุมในจอ
        local CamCF = Camera.CFrame
        local Dir = (PHead.Position - CamCF.Position).Unit
        local Angle = math.acos(CamCF.LookVector:Dot(Dir))
        if Angle > math.rad(CONFIG.FOV) then continue end

        -- เลือกคนที่มุมใกล้ศูนย์จอที่สุด
        local Score = Angle * Dist
        if Score < BestScore then
            BestScore = Score
            Best = PHead
        end
    end
    return Best
end

-- ==============================================
-- 🔄 ล็อคหัว — ทำงานทุกเฟรม
-- ==============================================
RunService.RenderStepped:Connect(function()
    if not State.SystemActive or not State.Holding then return end
    if not Root or not Camera then return end

    local Target = GetBestTarget()
    if not Target then return end

    -- จุดตรงกลางหัว
    local TargetPos = Target.Position + CONFIG.HeadCenter

    -- สุ่มเบี่ยงเล็กน้อย กันแบน
    if CONFIG.AntiDetect and CONFIG.RandomOffset > 0 then
        local Rand = CONFIG.RandomOffset
        TargetPos += Vector3.new(
            math.random() * Rand * 2 - Rand,
            math.random() * Rand * 2 - Rand,
            math.random() * Rand * 2 - Rand
        )
    end

    -- คำนวณมุมกล้อง
    local CamPos = Camera.CFrame.Position
    local DesiredCF = CFrame.new(CamPos, TargetPos)

    -- ล็อคแบบนุ่มนวล ดูเป็นคน
    local NewCF = Camera.CFrame:Lerp(DesiredCF, 1 / CONFIG.Smoothness * CONFIG.SnapSpeed)
    Camera.CFrame = NewCF
end)

